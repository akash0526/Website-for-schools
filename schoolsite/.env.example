# Demo works without any credentials. Never enable demo mode in production.
APP_MODE=demo
NODE_ENV=development
PORT=3001
CLIENT_ORIGINS=http://localhost:5173
SCHOOL_SLUG=evergreen
# Set to 1 ONLY behind a trusted reverse proxy (e.g. Render/Railway).
TRUST_PROXY=0

# LIVE MODE: set APP_MODE=live and fill all four Supabase values.
# Use a separate Supabase project for every school.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# ImageKit: Developer options > API keys. Private key stays on the server.
IMAGEKIT_PUBLIC_KEY=public_YOUR_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
IMAGEKIT_UPLOAD_FOLDER=/evergreen/uploads
MAX_UPLOAD_MB=5
